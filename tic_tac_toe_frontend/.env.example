# Example environment configuration for the Tic Tac Toe React app

# OpenAI (optional, enables AI trash talk)
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here
# REACT_APP_OPENAI_MODEL=gpt-4o-mini

# OpenWeatherMap (required to enable weather widget)
REACT_APP_OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
