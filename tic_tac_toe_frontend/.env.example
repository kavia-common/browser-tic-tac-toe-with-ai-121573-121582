# Copy this file to .env and fill in your values.
# The API key is embedded in the client bundle for local development only.
# For production, consider routing requests through a secure server-side proxy.

REACT_APP_OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: override the default model (defaults to gpt-4o-mini)
REACT_APP_OPENAI_MODEL=gpt-4o-mini
